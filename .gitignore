# =====================================================================
# ReelSpark — Git Ignore Configuration
# =====================================================================

# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment files & Secrets
# NEVER commit real environment files or secret keys to version control
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly keep example environment template tracked
!.env.example

# Next.js Build & Outputs
/.next/
/out/
/build/
/.vercel/

# TypeScript Build Info & Generated Types
*.tsbuildinfo
next-env.d.ts

# Local Runtime Storage & User Generated Media
# Prevents large video uploads, rendered reels, and transcripts from polluting git
/storage/*
!/storage/.gitkeep
/temp/*
!/temp/.gitkeep
/uploads/*
/rendered/*
public/uploads/*
public/temp/*
public/rendered/*

# Standalone Media Service Runtime
/services/media-service/temp/*
/services/media-service/uploads/*

# Supabase Local Cache & State
.supabase/

# Local AI / Whisper Models & Weights
models/
whisper-models/
*.pt

# Native Media Binaries & Executables
# Windows/Mac/Linux binaries exceed GitHub's 100MB per-file upload limit
*.exe
/bin/*
!/bin/.gitkeep

# Testing & Coverage
/coverage/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Cryptographic & Security Keys
*.pem
*.key
*.cert
*.crt
