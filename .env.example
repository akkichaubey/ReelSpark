# =====================================================================
# ReelSpark — Environment Configuration
# Ollama (Local AI) + Cloudflare Pages + D1 + R2 + Workers AI (Free)
# =====================================================================

# ─── Ollama Configuration (100% Free & Local AI) ─────────────────────────
# Default: http://127.0.0.1:11434
# Run `ollama serve` and `ollama pull llama3.2` on your local system
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ─── Cloudflare Credentials (for D1 Database & R2 Storage) ────────────────
# Find Account ID: Cloudflare Dashboard → right sidebar
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# API Token: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Required permissions: Workers AI:Run, D1:Edit, R2:Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ─── Cloudflare D1 Database ───────────────────────────────────────────────────
# Create: npx wrangler d1 create reelspark-db
# Get ID: npx wrangler d1 list
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid_here

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Create: npx wrangler r2 bucket create reelspark-storage
CLOUDFLARE_R2_BUCKET_NAME=reelspark-storage
# Public URL of your R2 bucket (enable public access in CF dashboard)
CLOUDFLARE_R2_PUBLIC_URL=https://pub-REPLACE.r2.dev

# ─── Media Service (FFmpeg — Render.com free tier) ────────────────────────────
# The Next.js frontend on Cloudflare Pages calls this service for:
#   - Video cutting / clip extraction
#   - Audio extraction (MP3)
#   - Caption rendering (MP4 with burned-in subtitles)
NEXT_PUBLIC_MEDIA_SERVICE_URL=https://your-app-name.onrender.com
MEDIA_SERVICE_HOST=0.0.0.0
MEDIA_SERVICE_PORT=4000

# ─── Optional: Binary Paths (local dev only) ──────────────────────────────────
# If omitted, auto-detects ffmpeg/ffprobe in ./bin/ or system PATH
# FFMPEG_PATH=./bin/ffmpeg.exe
# FFPROBE_PATH=./bin/ffprobe.exe

# ─── Port (local dev) ────────────────────────────────────────────────────────
PORT=3000
