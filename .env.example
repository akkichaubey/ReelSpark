# =====================================================================
# ReelSpark — Local-First Video to Reels Studio Environment Config
# =====================================================================

# Google Gemini API Key for video semantic understanding & speech-to-text
# Server-side exclusive: never exposed to browser client
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g., gemini-3.8-flash, gemini-3.0-flash, gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Custom binary paths for FFmpeg and FFprobe
# If omitted, automatically detects binaries in ./bin/ or system PATH
# FFMPEG_PATH=./bin/ffmpeg.exe
# FFPROBE_PATH=./bin/ffprobe.exe

# Port configuration (default: 3000)
PORT=3000

# =====================================================================
# Video & Audio Clipping Studio (Phase 1 Foundation)
# =====================================================================

# Local Media Service Configuration (Runs on 127.0.0.1 on your PC)
NEXT_PUBLIC_MEDIA_SERVICE_URL=http://127.0.0.1:4000
MEDIA_SERVICE_HOST=127.0.0.1
MEDIA_SERVICE_PORT=4000
# Optional: shared secret token for media service requests
# MEDIA_SERVICE_TOKEN=your_secure_local_service_token_here

# Supabase PostgreSQL Configuration (Metadata, Clips, Recipes & Lineage)
# If omitted, ReelSpark seamlessly operates in 100% resilient local-first mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side only: never exposed to browser client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Security: this app is local-only by default because it stores media and an
# optional Gemini key on disk. Set to true only behind your own authentication.
# REELSPARK_ALLOW_REMOTE=false
