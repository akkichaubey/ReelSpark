# =====================================================================
# ReelSpark — Environment Configuration
# Google sign-in: create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Demo access is disabled by default, and always disabled in production.
ALLOW_DEMO_LOGIN=false

# Local development automatically creates storage/.publishing-secret on first use.
# Optional local override below; do not use the same database with different encryption keys.
# Live requires a stable secret across deploys; Render Blueprint generates it automatically.
# Existing manually-created Render services need it set once. Never commit the real value.
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OAUTH_ENCRYPTION_KEY=
# Optional platform developer credentials; configure callback URLs separately.
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# Enable only after applying the reviewed project_documents D1 migration.
# Metadata only: this does not back up videos or rendered exports.
CLOUD_PROJECT_METADATA_ENABLED=false

# Private media is opt-in after migration 0002 and private R2 configuration.
CLOUD_PRIVATE_MEDIA_ENABLED=false
CLOUD_MEDIA_LIFECYCLE_ENABLED=false
R2_ACCESS_KEY_ID=your-private-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-private-r2-secret-access-key

# Ollama (Local AI) + Cloudflare Pages + D1 + R2 + Workers AI (Free)
# =====================================================================

# ─── Ollama Configuration (100% Free & Local AI) ─────────────────────────
# Default: http://127.0.0.1:11434
# Run `ollama serve` and `ollama pull llama3.2` on your local system
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ─── Cloudflare Credentials (for D1 Database & R2 Storage) ────────────────
# Find Account ID: Cloudflare Dashboard → right sidebar
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# API Token: Cloudflare Dashboard → My Profile → API Tokens → Create Token
# Required permissions: Workers AI:Run, D1:Edit, R2:Edit
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ─── Cloudflare D1 Database ───────────────────────────────────────────────────
# Create: npx wrangler d1 create reelspark-db
# Get ID: npx wrangler d1 list
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid_here

# ─── Cloudflare R2 Storage ────────────────────────────────────────────────────
# Create: npx wrangler r2 bucket create reelspark-storage
CLOUDFLARE_R2_BUCKET_NAME=reelspark-storage
# Public URL of your R2 bucket (enable public access in CF dashboard)
CLOUDFLARE_R2_PUBLIC_URL=https://pub-REPLACE.r2.dev

# ─── Media Service (FFmpeg — Render.com free tier) ────────────────────────────
# The Next.js frontend on Cloudflare Pages calls this service for:
#   - Video cutting / clip extraction
#   - Audio extraction (MP3)
#   - Caption rendering (MP4 with burned-in subtitles)
NEXT_PUBLIC_MEDIA_SERVICE_URL=https://your-app-name.onrender.com
MEDIA_SERVICE_HOST=0.0.0.0
MEDIA_SERVICE_PORT=4000

# ─── Optional: Binary Paths (local dev only) ──────────────────────────────────
# If omitted, auto-detects ffmpeg/ffprobe in ./bin/ or system PATH
# FFMPEG_PATH=./bin/ffmpeg.exe
# FFPROBE_PATH=./bin/ffprobe.exe

# ─── Port (local dev) ────────────────────────────────────────────────────────
PORT=3000
