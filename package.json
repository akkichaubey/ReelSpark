{
  "name": "reelspark",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "dev": "next dev",
    "predev:https": "node scripts/check-node.cjs",
    "dev:https": "next dev --experimental-https",
    "media-service": "tsx services/media-service/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:server": "node scripts/verify-server.cjs",
    "deploy:preflight": "node scripts/deployment-preflight.cjs",
    "verify:linux-render": "tsx scripts/smoke-linux-render.ts",
    "test": "tsx tests/test_suite.ts",
    "test:studio": "tsx tests/unified_studio.test.ts",
    "test:autocut": "tsx tests/auto_cut_intelligence.test.ts",
    "test:storage": "tsx tests/storage_maintenance.test.ts",
    "test:private-media": "tsx tests/private_media_cloud.test.ts",
    "test:cta": "tsx tests/reels_cta_presets.test.ts",
    "test:social": "tsx tests/smart_social_intelligence.test.ts",
    "test:social-platform": "tsx tests/social_post_platform_rules.test.ts",
    "test:publishing-stage1": "tsx tests/social_publishing_stage1.test.ts",
    "test:publishing-pipeline": "tsx tests/social_publishing_pipeline.test.ts",
    "test:publishing-security": "tsx tests/social_publishing_security.test.ts",
    "test:runtime": "tsx tests/runtime_environment.test.ts",
    "test:runtime:http": "node tests/runtime_http_smoke.cjs",
    "test:google-auth": "tsx tests/google_auth.test.ts",
    "test:safe-zone": "tsx tests/safe_zone_measurement_system.test.ts",
    "test:safe-sync": "tsx tests/safe_zone_caption_and_thumbnail_sync.test.ts",
    "test:presets": "tsx tests/presets_comprehensive_analysis.test.ts",
    "test:caption-sync": "tsx tests/caption_sync.test.ts",
    "test:caption-preview": "tsx tests/caption_preview_render.test.tsx",
    "test:voice-background": "tsx tests/voice_video_background.test.tsx",
    "test:saved-reels": "tsx tests/saved_reels.test.ts",
    "test:clip-review": "tsx tests/antigravity_saved_reels.test.ts",
    "test:caption-remotion": "tsx tests/caption_remotion_render.test.ts",
    "test:hooks": "tsx tests/hook_quality.test.ts",
    "test:qa": "tsx tests/qa_full_audit.ts",
    "test:e2e": "node scripts/test_api.js",
    "postinstall": "node scripts/patch-remotion.js",
    "cf:d1:create": "wrangler d1 create reelspark-db",
    "cf:d1:migrate": "wrangler d1 execute reelspark-db --file=src/lib/cloudflare/schema.sql",
    "cf:d1:migrate:local": "wrangler d1 execute reelspark-db --local --file=src/lib/cloudflare/schema.sql",
    "cf:r2:create": "wrangler r2 bucket create reelspark-storage",
    "cf:deploy": "wrangler pages deploy .next",
    "cf:dev": "wrangler pages dev .next --port 3001",
    "test:timeline": "tsx tests/professional_timeline.test.ts",
    "test:timeline-advanced": "tsx tests/advanced_timeline_edits.test.ts",
    "test:timeline-audio": "tsx tests/timeline_audio_editing.test.ts",
    "test:timeline-captions": "tsx tests/timeline_caption_editing.test.ts",
    "test:timeline-motion": "tsx tests/timeline_motion.test.ts",
    "test:timeline-thumbnails": "tsx tests/timeline_thumbnails.test.ts",
    "test:timeline-render": "tsx tests/professional_timeline.test.ts --render",
    "test:thumbnail-cover": "tsx tests/thumbnail_cover_render.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@remotion/bundler": "^4.0.534",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "^4.0.534",
    "archiver": "^8.0.0",
    "class-variance-authority": "0.7.1",
    "gsap": "^3.15.0",
    "jose": "6.2.13",
    "lucide-react": "^1.54.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.534",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "11.0.5"
    },
    "@remotion/studio": {
      "zod": "4.6.7"
    },
    "@remotion/elevenlabs": {
      "zod": "4.6.7"
    },
    "@remotion/media": {
      "zod": "4.6.7"
    },
    "@remotion/openai-whisper": {
      "zod": "4.6.7"
    },
    "@remotion/studio-protocol": {
      "zod": "4.6.7"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
