{
  "name": "reelspark",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "predev": "node scripts/check-node.cjs",
    "prebuild": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "dev": "next dev",
    "predev:https": "node scripts/check-node.cjs",
    "dev:https": "next dev --experimental-https",
    "media-service": "tsx services/media-service/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "deploy:preflight": "node scripts/deployment-preflight.cjs",
    "verify:linux-render": "tsx scripts/smoke-linux-render.ts",
    "postinstall": "node scripts/patch-remotion.js",
    "cf:d1:create": "wrangler d1 create reelspark-db",
    "cf:d1:migrate": "wrangler d1 execute reelspark-db --file=src/lib/cloudflare/schema.sql",
    "cf:d1:migrate:local": "wrangler d1 execute reelspark-db --local --file=src/lib/cloudflare/schema.sql",
    "cf:r2:create": "wrangler r2 bucket create reelspark-storage",
    "cf:deploy": "wrangler pages deploy .next",
    "cf:dev": "wrangler pages dev .next --port 3001"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@remotion/bundler": "^4.0.534",
    "@remotion/player": "4.0.538",
    "@remotion/renderer": "^4.0.534",
    "archiver": "^8.0.0",
    "class-variance-authority": "0.7.1",
    "gsap": "^3.15.0",
    "jose": "6.2.13",
    "lucide-react": "^1.54.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "^4.0.534",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "readdir-glob": {
      "minimatch": "11.0.5"
    },
    "@remotion/studio": {
      "zod": "4.6.7"
    },
    "@remotion/elevenlabs": {
      "zod": "4.6.7"
    },
    "@remotion/media": {
      "zod": "4.6.7"
    },
    "@remotion/openai-whisper": {
      "zod": "4.6.7"
    },
    "@remotion/studio-protocol": {
      "zod": "4.6.7"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/turbopack": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.3"
  }
}
